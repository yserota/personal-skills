# Publishing target: none | excel | google_sheets
#   excel        → writes a single .xlsx workbook to out/ (no Google setup needed)
#   google_sheets → pushes tabs directly to a Google Sheet (requires service account)
DCI_PUBLISH_TARGET=none

# Google Sheets settings (required only when DCI_PUBLISH_TARGET=google_sheets)
# Sheet ID is the long string in the spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
DCI_GOOGLE_SHEET_ID=
# Path to the GCP service-account key JSON downloaded from Google Cloud Console
DCI_GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
DCI_GOOGLE_WORKSHEET=dci_writer_scores
DCI_GOOGLE_AUDIT_WORKSHEET=run_audit_log

# Optional defaults for your run scripts
DCI_JIRA_INPUT=../jira-export.csv
DCI_INPUT_CSV_PATH=data/input.from_jira.csv
DCI_OUTPUT_DIR=out
DCI_MANAGER_MAP_PATH=config/writer_manager_map.csv

# Reporting window (Q1-26)
DCI_PERIOD_START=2026-01-01
DCI_PERIOD_END=2026-03-31
