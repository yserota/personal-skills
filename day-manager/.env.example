# ── Slack ─────────────────────────────────────────────────────────────────────
# Bot token from your Slack App (xoxb-...)
# See SETUP.md section 4 to create the Slack app
SLACK_TOKEN=xoxb-your-token-here

# Comma-separated channel names to ingest (no # prefix)
# Example: general,engineering,your-team-channel
SLACK_CHANNELS=general

# ── Storage ───────────────────────────────────────────────────────────────────
# Local path where Google Drive for Desktop syncs the day-manager folder.
# The Google Apps Script writes gmail.txt and calendar.txt there each morning.
#
# Find your Drive sync path (run in PowerShell):
#   Test-Path "C:\Users\yserota\Google Drive\My Drive\day-manager"
#   Test-Path "C:\Users\yserota\My Drive\day-manager"
#   Test-Path "G:\My Drive\day-manager"
#
# Example:
#   DATA_DIR=C:\Users\yserota\Google Drive\My Drive\day-manager
#
# Or use the local data/ folder in this project (no Drive sync):
DATA_DIR=data
